========================
1. LINUX BASIC COMMANDS
========================

pwd
# Current directory

ls
# Files and folders

ls -la
# Hidden files ke saath

cd folder-name
# Folder ke andar jaana

cd ..
# Ek level back

cd ~
# Home directory

clear
# Terminal clear

history
# Previous commands


========================
2. FILE & DIRECTORY COMMANDS
========================

touch file.txt
# New file

mkdir my-folder
# New directory

mkdir -p parent/child
# Nested directory

cp file.txt backup.txt
# Copy file

mv old.txt new.txt
# Rename/move file

rm file.txt
# Delete file

rm -r my-folder
# Delete directory

cat file.txt
# File content


========================
3. VIM COMMANDS
========================

vim main.tf
# Open file

i
# Insert/Edit mode

Esc
# Exit insert mode

:w
# Save

:wq
# Save and Exit

:q!
# Exit without saving


========================
4. LINUX PERMISSIONS
========================

ls -l
# Permissions check

chmod 400 terraform_keyPair.pem
# Private SSH key permission

chmod +x script.sh
# Executable permission


========================
5. LINUX SYSTEM COMMANDS
========================

ps
# Running processes

ps aux
# All running processes

top
# Live processes

kill <PID>
# Kill process

df -h
# Disk space

du -sh .
# Current folder size

free -h
# RAM usage

lscpu
# CPU information


